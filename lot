	if i.KeyCode == settings.togglekey and not main.switching then
		main.switching = true
		main.on = not main.on
		if not main.on then
			main.victims = {}
			main.pressing = false
			main.minedone = {}
			main.sentrydone = {}
			wipebodytags()
			wipeminetags()
			wipesentrytags()
			wipeloottags()
			wipelootlabels()
			if main.fovcircle then
				main.fovcircle.Visible = false
			end
			toast("Silent OFF", Color3.fromRGB(255, 120, 120))
