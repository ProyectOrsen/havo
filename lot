				billboard.StudsOffset = Vector3.new(0, 2.2, 0)
				billboard.AlwaysOnTop = true
				billboard.LightInfluence = 0
				billboard.MaxDistance = 500
				billboard.Adornee = base

				local label = Instance.new("TextLabel")
				label.BackgroundTransparency = 1
				label.Size = UDim2.new(1, 0, 1, 0)
				label.Text = ""
				label.TextColor3 = settings.cashcolor
				label.TextStrokeTransparency = 0.35
				label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
				label.TextSize = 14
				label.Font = Enum.Font.GothamBold
				label.TextXAlignment = Enum.TextXAlignment.Center
				label.Parent = billboard

				billboard.Parent = main.screen
				entry = {billboard = billboard, label = label, lasttext = "", lastcheck = 0, cached = 0}
				main.lootlabels[base] = entry
			end

			if now - entry.lastcheck >= settings.cashrefresh then
				entry.lastcheck = now
				entry.cached = getcash(base)
				local text = "$" .. formatcash(entry.cached)
				if text ~= entry.lasttext then
					entry.lasttext = text
					entry.label.Text = text
				end
				entry.label.TextTransparency = entry.cached > 0 and 0 or 1
				entry.label.TextStrokeTransparency = entry.cached > 0 and 0.35 or 1
			end
		end
	end

	local gone = {}
	for base, entry in pairs(main.lootlabels) do
		if not active[base] or not base.Parent then
			table.insert(gone, base)
		end
	end
	for _, base in ipairs(gone) do
		local entry = main.lootlabels[base]
		if entry and entry.billboard then
			pcall(function() entry.billboard:Destroy() end)
		end
		main.lootlabels[base] = nil
	end
end

local function currenttool()
	local char = player.Character
	if not char then return nil end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		local equipped = hum:FindFirstChildOfClass("Tool")
		if equipped and equipped.Parent == char then return equipped end
	end

	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then return c end
	end

	return nil
end

local function grabtool()
	for i = 1, settings.tooltries do
		local tool = currenttool()
		if tool then return tool end
		task.wait(settings.toolwait)
	end
	return nil
end

local function findhead(model)
	if not model then return nil end
	return model:FindFirstChild(settings.silentpart)
		or model:FindFirstChild("Head")
		or model:FindFirstChild("HeadCollider")
end

local function getowner(model)
	if not model then return nil end
	local p = Players:GetPlayerFromCharacter(model)
	if p then return p end
	local byname = Players:FindFirstChild(model.Name)
	if byname and byname.Character == model then return byname end
	return nil
end

local function isplayer(model)
	return getowner(model) ~= nil
end

local function nearbybodies()
	local char = player.Character
	if not char then return {} end
	local folder = char.Parent
	if not folder or folder == workspace then return {} end
	local list = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child ~= char and child:IsA("Model") then
			local hum = child:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				table.insert(list, child)
			end
		end
	end
	return list
end

local function aimpart(model)
	local cursor = UserInputService:GetMouseLocation()
	local best, bestdist = nil, math.huge
	for _, name in ipairs(susparts) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			local sp = camera:WorldToViewportPoint(part.Position)
			if sp.Z > 0 then
				local d = (Vector2.new(sp.X, sp.Y) - cursor).Magnitude
				if d < bestdist then
					bestdist = d
					best = part
				end
			end
		end
	end
	if not best then
		best = findhead(model)
	end
	return best
end

local function scanbodies()
	local cursor = UserInputService:GetMouseLocation()
	local mychar = player.Character
	local mypos = mychar and mychar:GetPivot().Position
	local list = {}
	local bestPlayer = nil
	local bestPlayerDist = math.huge

	for _, char in ipairs(nearbybodies()) do
		local head = findhead(char)
		if head then
			local isp = isplayer(char)
			local skip = false
			if isp and settings.ignorefriends then
				local owner = getowner(char)
				if checkfriend(owner) then
					skip = true
				end
			end
			if not skip then
				local sp = camera:WorldToViewportPoint(head.Position)
				if sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - cursor).Magnitude
					if d <= settings.fov then
						local worldDist = math.huge
						if mypos then
							worldDist = (head.Position - mypos).Magnitude
						end
						if isp then
							if worldDist <= settings.playermaxrange then
								if d < bestPlayerDist then
									bestPlayerDist = d
									bestPlayer = {
										char = char,
										head = head,
										dist = d,
										isplayer = true,
										isclose = true,
									}
								end
							end
						else
							table.insert(list, {
								char = char,
								head = head,
								dist = d,
								isplayer = false,
								isclose = mypos and worldDist <= settings.closerange or false,
							})
						end
					end
				end
			end
		end
	end

	if bestPlayer then
		return {bestPlayer}
	end

	table.sort(list, function(a, b)
		if a.isclose ~= b.isclose then
			return a.isclose
		end
		return a.dist < b.dist
	end)

	if #list > settings.maxtargets then
		for i = #list, settings.maxtargets + 1, -1 do
			list[i] = nil
		end
	end

	return list
end

local function scanmines()
	local cursor = UserInputService:GetMouseLocation()
	local list = {}
	for _, mine in ipairs(main.minecache) do
		if mine and mine.Parent then
			local sp = camera:WorldToViewportPoint(mine.Position)
			if sp.Z > 0 then
				local d = (Vector2.new(sp.X, sp.Y) - cursor).Magnitude
				if d <= settings.fov then
					table.insert(list, {mine = mine, dist = d})
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function scansentries()
	local cursor = UserInputService:GetMouseLocation()
	local list = {}
	for _, s in ipairs(main.sentrycache) do
		if s and s.Parent then
			local sp = camera:WorldToViewportPoint(s.Position)
			if sp.Z > 0 then
				local d = (Vector2.new(sp.X, sp.Y) - cursor).Magnitude
				if d <= settings.fov then
					table.insert(list, {
						sentry = s,
						parent = s.Parent,
						dist = d,
					})
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function scanloots()
	local cursor = UserInputService:GetMouseLocation()
	local list = {}
	for _, base in ipairs(main.lootcache) do
		if base and base.Parent then
			local sp = camera:WorldToViewportPoint(base.Position)
			if sp.Z > 0 then
				local d = (Vector2.new(sp.X, sp.Y) - cursor).Magnitude
				if d <= settings.fov then
					table.insert(list, base)
				end
			end
		end
	end
	return list
end

local function nextmine()
	local list = scanmines()
	if #list == 0 then return nil end

	local stillthere = {}
	for _, entry in ipairs(list) do
		stillthere[entry.mine] = true
	end

	local clean = {}
	for m, _ in pairs(main.minedone) do
		if not stillthere[m] then
			table.insert(clean, m)
		end
	end
	for _, m in ipairs(clean) do
		main.minedone[m] = nil
	end

	for _, entry in ipairs(list) do
		if not main.minedone[entry.mine] then
			return entry.mine
		end
	end

	main.minedone = {}
	return list[1].mine
end

local function nextsentry()
	local list = scansentries()
	if #list == 0 then return nil end

	local stillthere = {}
	for _, entry in ipairs(list) do
		stillthere[entry.sentry] = true
	end

	local clean = {}
	for m, _ in pairs(main.sentrydone) do
		if not stillthere[m] then
			table.insert(clean, m)
		end
	end
	for _, m in ipairs(clean) do
		main.sentrydone[m] = nil
	end

	for _, entry in ipairs(list) do
		if not main.sentrydone[entry.sentry] then
			return entry.sentry
		end
	end

	main.sentrydone = {}
	return list[1].sentry
end

local function throughwall(origin, targetpos, targetchar)
	local dir = targetpos - origin
	if dir.Magnitude < 0.001 then return true end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {player.Character, targetchar}

	local result = workspace:Raycast(origin, dir, params)
	if not result then return true end

	local hitpart = result.Instance
	if not hitpart or not hitpart:IsA("BasePart") then return false end

	local size = hitpart.Size
	local thickness = math.min(size.X, size.Y, size.Z)
	return thickness <= settings.wallbangthickness
end

local function inrange(char)
	local mychar = player.Character
	if not mychar then return false end
	local mypos = mychar:GetPivot().Position
	local head = findhead(char)
	local refpos = head and head.Position or char:GetPivot().Position
	return (refpos - mypos).Magnitude <= settings.playermaxrange
end

local function wipebodytags()
	for model, hl in pairs(main.bodytags) do
		pcall(function() hl:Destroy() end)
	end
	main.bodytags = {}
end

local function updatebodytags(victims)
	local active = {}
	for _, t in ipairs(victims) do
		local char = t.char
		active[char] = true
		local hl = main.bodytags[char]
		if not hl or not hl.Parent then
			hl = Instance.new("Highlight")
			hl.Adornee = char
			pcall(function()
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			end)
			if t.isplayer then
				hl.FillColor = settings.playercolor
				hl.OutlineColor = settings.playercolor
				hl.FillTransparency = 1
				hl.OutlineTransparency = 0.35
			else
				hl.FillColor = settings.npccolor
				hl.OutlineColor = settings.npccolor
				hl.FillTransparency = 1
				hl.OutlineTransparency = 0.1
			end
			hl.Parent = main.screen
			main.bodytags[char] = hl
		end
	end
	local gone = {}
	for model, hl in pairs(main.bodytags) do
		if not active[model] or not model.Parent then
			table.insert(gone, model)
		end
	end
	for _, model in ipairs(gone) do
		local hl = main.bodytags[model]
		if hl then pcall(function() hl:Destroy() end) end
		main.bodytags[model] = nil
	end
end

local function thread(fn, ...)
	local args = {...}
	coroutine.wrap(function()
		pcall(fn, table.unpack(args))
	end)()
end

local function sendshot(remote, tool, origin, dir)
	if not remote then return end
	thread(function(r, t, o, d)
		r:FireServer(t, o, d)
	end, remote, tool, origin, dir)
end

local function sendhit(remote, targetchar, tool, part, partpos, normal, dir)
	if not remote then return end
	thread(function(r, tc, t, p, pp, n, d)
		r:InvokeServer(tc, t, p, pp, {
			Normal = n,
			Instance = p,
			Position = pp,
		}, d)
	end, remote, targetchar, tool, part, partpos, normal, dir)
end

local function sendmine(remote, tool, mine, minepos)
	if not remote then return end
	thread(function(r, t, m, mp)
		r:InvokeServer(t, m, mp)
	end, remote, tool, mine, minepos)
end

local function sendsentry(remote, tool, sentry, sentrypos)
	if not remote then return end
	thread(function(r, t, s, sp)
		r:InvokeServer(t, s, sp)
	end, remote, tool, sentry, sentrypos)
end

local function hitbody(t, tool, origin, bypassCooldown)
	local char = t.char
	if not char or not char.Parent then return end

	if t.isplayer and settings.ignorefriends then
		local owner = getowner(char)
		if checkfriend(owner) then
			return
		end
	end

	if t.isplayer then
		if not inrange(char) then
			return
		end
		if not bypassCooldown then
			if tick() - main.lastplayerping < settings.playerhitinterval then
				return
			end
		end
	end

	local toolnow = currenttool() or tool
	if not toolnow or not toolnow.Parent then return end

	local targetpart
	if t.isplayer then
		targetpart = aimpart(char)
	else
		targetpart = findhead(char)
	end
	if not targetpart or not targetpart.Parent then return end

	local partpos = targetpart.Position

	if t.isplayer then
		local ok, can = pcall(throughwall, origin, partpos, char)
		if ok and not can then
			return
		end
	end

	local dir = partpos - origin
	if dir.Magnitude < 0.001 then
		dir = Vector3.new(0, 0, -1)
	else
		dir = dir.Unit
	end
	local normal = -dir

	if t.isplayer then
		main.lastplayerping = tick()
	end

	sendshot(main.shootevt, toolnow, origin, dir)
	sendhit(main.hitevt, char, toolnow, targetpart, partpos, normal, dir)
end

local function hitonemine(tool)
	local mine = nextmine()
	if not mine then return false end
	main.minedone[mine] = true
	sendmine(main.mineevt, tool, mine, mine.Position)
	return true
end

local function hitonesentry(tool)
	local s = nextsentry()
	if not s then return false end
	main.sentrydone[s] = true
	sendsentry(main.sentryevt, tool, s, s.Position)
	return true
end

local function goham(quiet)
	if not main.on then return end
	if not player.Character then return end

	local tool = grabtool()
	if not tool then
		if not quiet then
			toast("No tool", Color3.fromRGB(255, 120, 120))
		end
		return
	end

	local victims = scanbodies()
	local origin = camera.CFrame.Position

	local bypassCooldown = not quiet
	local playerOnly = (#victims == 1) and victims[1].isplayer

	for _, t in ipairs(victims) do
		hitbody(t, tool, origin, bypassCooldown)
	end

	local minehit = false
	local sentryhit = false
	if not playerOnly then
		minehit = hitonemine(tool)
		sentryhit = hitonesentry(tool)
	end

	if not quiet then
		local label
		if playerOnly then
			label = "Player"
		elseif #victims == 1 then
			label = victims[1].isplayer and "Player" or "NPC"
		elseif #victims > 1 then
			label = #victims .. " NPCs"
		else
			label = "No target"
		end
		if minehit then
			label = label .. " + Mine"
		end
		if sentryhit then
			label = label .. " + Sentry"
		end

		local full = string.format("%s | %s", label, tool.Name)
		if full ~= main.lastsignature then
			main.lastsignature = full
			toast(full, Color3.fromRGB(120, 200, 255))
		end
	end
end

local function holdloop()
	if main.holding then return end
	main.holding = true
	task.spawn(function()
		local starttime = tick()
		while main.pressing and main.on do
			if tick() - starttime >= settings.holddelay then
				pcall(goham, true)
			end
			task.wait(settings.holdinterval)
		end
		main.holding = false
	end)
end

