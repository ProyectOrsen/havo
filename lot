	if main.minechild then
		pcall(function() main.minechild:Disconnect() end)
		main.minechild = nil
	end

	digmines(field)

	main.minedesc = field.DescendantAdded:Connect(function(d)
		if d.Name == settings.minename and d:IsA("BasePart") then
			keepmine(d)
		end
	end)

	main.minechild = field.ChildAdded:Connect(function()
		task.wait(0.1)
		digmines(field)
	end)
