local function getfriends()
	main.friendlist = {}
	pcall(function()
		local ok, list = pcall(function()
			return Players:GetFriendsAsync(player.UserId)
		end)
		if ok and list then
			while true do
				local okpage, page = pcall(function() return list:GetCurrentPage() end)
				if not okpage or not page then break end
				for _, entry in ipairs(page) do
					main.friendlist[entry.Id] = true
				end
				if list.IsFinished then break end
				local okadv = pcall(function() list:AdvanceToNextPageAsync() end)
				if not okadv then break end
			end
		end
	end)
end

local function checkfriend(p)
	if not settings.ignorefriends then return false end
	if not p then return false end
	if p == player then return false end
	if p:IsFriendsWith(player.UserId) then
		return true
	end
	if main.friendlist[p.UserId] then
		return true
	end
	return false
end

